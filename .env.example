# ---------------------------------------------------------------
# Bu dosyayı ".env.local" adıyla kopyala ve değerleri doldur.
# Değerler: Supabase paneli → Project Settings → API Keys / Data API
# ---------------------------------------------------------------

# Proje adresi (ör. https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Herkese açık anahtar (tarayıcıda kullanılır, gizli değildir)
# Yeni projelerde "Publishable key" (sb_publishable_...).
# Eski projelerde bunun yerine NEXT_PUBLIC_SUPABASE_ANON_KEY kullanabilirsin.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# GİZLİ anahtar — sadece sunucuda kullanılır, ASLA paylaşma!
# Yeni projelerde "Secret key" (sb_secret_...).
# Eski projelerde bunun yerine SUPABASE_SERVICE_ROLE_KEY kullanabilirsin.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------
# Gemini (Faz 3) — herkes KENDİ API anahtarını Ayarlar'dan girer.
# Bu değer, o anahtarları sunucuda şifrelemek için kullanılır (sadece sunucu).
# Üretmek için: openssl rand -base64 32
# Değiştirirsen kayıtlı anahtarlar okunamaz; herkes yeniden girmek zorunda kalır.
GEMINI_KEY_SECRET=

# İsteğe bağlı: kullanılacak model (boşsa gemini-3.5-flash-lite)
GEMINI_MODEL=
